{
  "manifest_version": 3,
  "name": "Volition",
  "description": "An AI website blocker that makes you negotiate for access to distracting sites.",
  "version": "1.1.4",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "https://api.openai.com/*", "https://volition-free-api-jordansafers-projects.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Volition",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
